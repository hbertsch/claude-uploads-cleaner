{
  "name": "claude-uploads-cleaner",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/unit/",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:issue-forms": "uvx check-jsonschema --builtin-schema vendor.github-issue-forms .github/ISSUE_TEMPLATE/bug_report.yml .github/ISSUE_TEMPLATE/layout_changed.yml",
    "screenshots": "node scripts/make-screenshots.mjs",
    "demo": "node scripts/make-demo-gif.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:build-reproducible": "node scripts/check-build-reproducible.mjs",
    "build": "node scripts/build.mjs",
    "lint:ext": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "web-ext": "^10.8.0"
  }
}
