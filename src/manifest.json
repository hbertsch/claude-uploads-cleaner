{
  "manifest_version": 3,
  "name": "Uploads Cleaner for claude.ai",
  "version": "1.0.1",
  "description": "Adds a button that deletes all uploaded files in the claude.ai privacy settings. Not affiliated with Anthropic.",
  "homepage_url": "https://github.com/hbertsch/claude-uploads-cleaner",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "content/config.js",
        "content/page.js",
        "content/ui.js",
        "content/runner.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
