{
  "manifest_version": 3,
  "name": "Claude Uploads Cleaner",
  "version": "1.0.0",
  "description": "Adds a button that deletes all uploaded files in the claude.ai privacy settings.",
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "content/config.js",
        "content/page.js",
        "content/ui.js",
        "content/runner.js",
        "content/main.js"
      ]
    }
  ]
}
